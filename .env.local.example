# Azure AI Foundry credentials — server-side only. Never expose these to the browser.
# Copy this file to `.env.local` and fill in the real values from your Foundry resource.
#
# ENDPOINT: paste your Foundry resource or project endpoint — the app reduces it
# to the resource host and appends /openai/v1/ for you. All of these work:
#   https://your-resource.services.ai.azure.com
#   https://your-resource.openai.azure.com
#   https://your-resource.services.ai.azure.com/api/projects/your-project
# No api-version is needed — the v1 API routes to the latest GA.

# Main chat model — used by most topics. A non-reasoning model is best here.
AZURE_AI_FOUNDRY_ENDPOINT=https://your-resource.services.ai.azure.com
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_DEPLOYMENT=gpt-5-chat

# Optional — reasoning-model deployment used by the reasoning topic.
# Defaults to gpt-5 if unset.
AZURE_OPENAI_REASONING_DEPLOYMENT=gpt-5

# Optional — embeddings deployment used by the RAG topic.
# Defaults to text-embedding-3-large if unset.
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large

# Optional — image-generation deployment used by the image-generation topic.
# Defaults to gpt-image-1. An image model must be deployed in your Foundry resource
# for that topic to work.
AZURE_OPENAI_IMAGE_DEPLOYMENT=gpt-image-1

# Microsoft Entra ID authentication (Auth.js v5)
# Run setup-entra-auth.ps1 to create the app registration and get these values.
# Generate AUTH_SECRET with: npx auth secret
AUTH_SECRET=your-auth-secret-here
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/your-tenant-id/v2.0
AUTH_MICROSOFT_ENTRA_ID_ID=your-client-id
AUTH_MICROSOFT_ENTRA_ID_SECRET=your-client-secret
